#############################################
#  Grid parameters
#############################################

structuredGrid = true
lower = 0
upper =  1
elements = 200

# Number of grid levels
numLevels = 1

#############################################
#  Solver parameters
#############################################

# Tolerance of the trust region solver
tolerance = 1e-8

# Max number of steps of the trust region solver
maxTrustRegionSteps = 100

# Initial trust-region radius
initialTrustRegionRadius = 0.25

# Number of multigrid iterations per trust-region step
numIt = 200

# Number of presmoothing steps
nu1 = 3

# Number of postsmoothing steps
nu2 = 3

# Number of coarse grid corrections
mu = 1

# Number of base solver iterations
baseIt = 100

# Tolerance of the multigrid solver
mgTolerance = 1e-10

# Tolerance of the base grid solver
baseTolerance = 1e-8

############################
#   Problem specifications
############################

# Type of energy we are minimizing
energy = harmonic

# Inverse stereographic projection
initialIterate = initial-curve

# Function of position returning '1' for each Dirichlet vertex
dirichletVerticesPredicate = "x[0] < 0.0001 or x[0]>0.999"

# Number of time steps
numTimeSteps = 50

# Time step size
timeStepSize = 2e-4
